# ===== Baza podatkov (PostgreSQL) =====
# Neon / Supabase / lokalni Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/beauty_salon"

# ===== NextAuth =====
# Ustvari z: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ===== Aplikacija =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Stripe (NEOBVEZNO) =====
# Priporočeno: admin vnese ključe v Nastavitve → Plačila (brez deploya).
# Ti ključi služijo le kot platformni fallback za salone brez svojih ključev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== Platformne naročnine (EPIC #3 E3-4, NEOBVEZNO) =====
# Ločen Stripe račun PLATFORME (najemniki → platforma tok denarja),
# popolnoma ločen od zgornjih per-tenant ključev (najemnik → njegove stranke).
# Brez teh ključev UI pošteno prikaže "setup required" — nič ni faked.
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_WEBHOOK_SECRET=""
# Recurring price ids za plačljive pakete (Stripe Dashboard → Products).
# Webhook endpoint: /api/webhooks/platform-stripe
PLATFORM_STRIPE_PRICE_PRO=""
PLATFORM_STRIPE_PRICE_SCALE=""

# ===== Operaterska konzola (EPIC #3 E3-5) =====
# E-poštni naslovi operaterjev platforme (ločeni z vejico). To je EDINI
# vir dostopa do /platform — fail-closed: prazen seznam = nihče nima dostopa.
# Najemniški lastniki (ADMIN v svoji org) NIKOLI niso operaterji po defaultu.
PLATFORM_ADMIN_EMAILS="ops@example.org"

# ===== Lastne domene (EPIC #3 E3-6, NEOBVEZNO) =====
# Ponudnik domen za povezovanje lastnih domen najemnikov (issue #3 §7).
# Vercel Domains API: token mora imeti dostop do projekta. BREZ teh ključev
# UI pošteno pokaže "ponudnik ni konfiguriran" — domena nikoli ni označena
# kot preverjena, dokler ponudnik tega NE POTRDI.
DOMAINS_VERCEL_TOKEN=""
DOMAINS_VERCEL_PROJECT_ID=""
# Neobvezno (za team račun): DOMAINS_VERCEL_TEAM_ID=""


# ============================================================
# #99 — PUSH obvestila lastniku (VAPID Web Push) + dnevni digest
# ============================================================
# Par ključev za VAPID — generiraj enkrat:
#   npx web-push generate-vapid-keys
# BREZ paru je push pošteno izklopljen (UI pokaže "ni nastavljeno"),
# dnevni digest po e-pošti pa deluje neodvisno (RESEND_API_KEY).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Predmet push pošiljatelja (mailto ali https URL).
VAPID_SUBJECT="mailto:info@markec.si"
