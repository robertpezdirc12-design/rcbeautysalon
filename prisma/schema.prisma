generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// TENANT — each salon (hairdresser, nail studio, cosmetician, ...)
// gets its own organization with own site at /s/[slug]
// ============================================================
model Organization {
  id              String    @id @default(cuid())
  slug            String    @unique // URL: /s/[slug] — validated against reserved routes
  name            String
  logo            String?
  vertical        String    @default("beauty") // activity profile id (see src/lib/profiles/registry.ts)
  palette         String    @default("rose") // theme palette key (see src/lib/verticals.ts)
  plan            String    @default("free")
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Suspension context (EPIC #3 E3-5): the operator-supplied reason is
  // displayed to the owner; the full audit trail lives in PlatformAuditLog.
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Activity profile engine (EPIC #1): resolved profile version the tenant was
  // onboarded/materialized against, and tenant-level overrides that never mutate
  // the shared profile definition. See src/lib/profiles/.
  profileVersion   String?
  profileOverrides Json?

  // Guided entry ("vodeni vstop"): timestamp of the moment the owner
  // CONFIRMED the activity inside the dashboard wizard. NULL = the wizard
  // is still shown first for settings managers (existing pre-wizard
  // tenants confirm their current vertical with one click — the wizard
  // is non-destructive for the same-vertical confirmation).
  verticalChosenAt DateTime?

  // Activation checklist ("vodena namestitev") owner state: only UI
  // preferences live here (dismissed/reopened). STEP COMPLETION is always
  // DERIVED from real business data (catalog edits, staff, customers,
  // bookings, publish state) — see src/lib/profiles/setup-checklist.ts.
  // Shape: { dismissedAt?: string } (ISO timestamp).
  setupChecklist Json?

  // Guided entry second-level answers (P2, the Shopify "prove you listened"
  // pattern): { teamSize?: "solo"|"small"|"team", onlineBooking?: "yes"|"no" }.
  // The answers VISIBLY change the product: "solo" removes the staff step
  // from the activation checklist; onlineBooking "no" rewords the publish
  // step (no 24/7 bookings promised). See src/lib/profiles/setup-checklist.ts.
  onboardingAnswers Json?

  // Secondary activity (EPIC #2 E2-4, G4): optional second activity profile id.
  // Capability UNION (primary ∪ secondary) while the PRIMARY profile stays the
  // owner of terminology, forms, workflows and site content — no "ugly" merged
  // terminology. Validated by src/lib/profiles/secondary.ts before any write.
  secondaryVertical String?

  // Configuration history (EPIC #2 E2-5, G5): append-only audit of config
  // changes (profile overrides, form/workflow definitions). A revert NEVER
  // rewrites or deletes history — it appends a NEW version entry.
  configChangeLogs ConfigChangeLog[]

  // Publication lifecycle (EPIC #3 E3-1): DRAFT sites are private (visible to
  // the owner as a preview, maintenance page for everyone else). Default
  // PUBLISHED preserves the pre-E3-1 behavior for existing tenants verbatim;
  // the onboarding flow explicitly creates new tenants as DRAFT.
  publishState String    @default("PUBLISHED") // DRAFT | PUBLISHED | UNPUBLISHED
  publishedAt  DateTime?

  // Site content versioning (EPIC #3 E3-2): incremented on every site content
  // save. Compared against SalonConfig.publishedContentVersion to detect
  // unpublished draft changes ("Objavi spremembe" / revert affordances).
  contentVersion Int @default(1)

  // Owner-supplied Stripe integration (entered by the admin in Settings →
  // Plačila). Optional: when absent, payments fall back to env keys and
  // gracefully degrade when neither exists.
  stripeSecretKey     String?   @db.Text
  stripeWebhookSecret String?   @db.Text
  stripeConfiguredAt  DateTime?

  users                User[]
  salonConfig          SalonConfig?
  categories           Category[]
  services             Service[]
  products             Product[]
  staff                Staff[]
  customers            Customer[]
  // #90: prijave na čakalno listo (zasedeni termini, obvestila ob prostoru)
  waitlistEntries      WaitlistEntry[]
  appointments         Appointment[]
  orders               Order[]
  media                Media[]
  formDefinitions      FormDefinition[]
  formSubmissions      FormSubmission[]
  workflowDefinitions  WorkflowDefinition[]
  workOrders           WorkOrder[]
  // #80: prepaid value — the EVOLVED Package table (@@map "Package"),
  // one primitive for gift cards + session packages.
  prepaidProducts      PrepaidProduct[]
  prepaidPurchases     PrepaidPurchase[]
  documents            Document[]
  productVariants      ProductVariant[]
  extensionRecords     ExtensionRecord[]
  platformSubscription PlatformSubscription?
  billingEvents        PlatformBillingEvent[]
  platformAuditLogs    PlatformAuditLog[]
  customDomains        CustomDomain[]
  stockMovements       StockMovement[]
  projects             Project[]
  projectTasks         ProjectTask[]
  customRoles          CustomRole[]
  reviews              Review[]

  @@index([slug])
  @@index([status])
}

// ============================================================
// PLATFORM SUBSCRIPTION (EPIC #3 E3-4) — the tenant's PAID PLAN
// with the PLATFORM (money flows to the platform account), as
// opposed to per-tenant Stripe keys that collect the tenant's OWN
// customer payments. Strict separation, per docs/EPIC-3/PLAN.md.
//
// State is driven EXCLUSIVELY by provider webhook events —
// nothing in this row is ever faked. Without a configured
// PLATFORM_STRIPE_* key the flow honestly reports "setup required".
// ============================================================
model PlatformSubscription {
  id             String @id @default(cuid())
  organizationId String @unique

  // Provider-side identifiers (null until a hosted checkout completes)
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Lifecycle mirrored from the provider:
  // INCOMPLETE | TRIALING | ACTIVE | PAST_DUE | CANCELED | UNPAID
  status String @default("INCOMPLETE")
  // Plan this subscription maps to (entitlements when ACTIVE/TRIALING)
  plan   String @default("free")

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Pending hosted-checkout intent (recorded at checkout creation).
  // The PLAN change itself NEVER happens here — only the webhook
  // confirmation moves entitlements (acceptance: webhook-driven).
  pendingCheckoutSessionId String?
  pendingPlanId            String?
  pendingAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       PlatformBillingEvent[]

  @@index([status])
}

// Immutable billing history — one row per provider event. The
// unique stripeEventId is the webhook idempotency key: a retried
// delivery can never be applied twice.
model PlatformBillingEvent {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String?
  stripeEventId  String    @unique
  type           String
  amountCents    Int?
  currency       String?
  plan           String?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription PlatformSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ============================================================
// PLATFORM AUDIT LOG (EPIC #3 E3-5) — append-only trail of
// platform-operator actions (suspend/reactivate tenant, …).
// Every operator action writes exactly one row BEFORE/AFTER the
// state change: who (actorEmail), what (action), why (reason).
// Rows are never updated or deleted (immutable history).
// ============================================================
model PlatformAuditLog {
  id             String   @id @default(cuid())
  organizationId String // tenant the action applies to (org-scoped by design)
  actorEmail     String // authenticated operator email
  action         String // PlatformAuditAction, e.g. TENANT_SUSPENDED
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// EPIC #4 E4-3: platform webhook failure log (§10 — "billing integration /
// webhook health and failed events"). Deliberately NOT org-scoped: many
// failures (rejected signature, malformed body, no tenant scoping) carry no
// trusted org context, and PlatformBillingEvent is the IDEMPOTENCY LOCK
// (stripeEventId @unique) — recording failures there would make Stripe's
// replay of a failed delivery look like an already-processed duplicate.
// stripeEventId/type are present only when the delivery was signature-verified
// far enough to trust them; unverified bodies are never parsed into them.
model PlatformWebhookFailure {
  id             String   @id @default(cuid())
  stripeEventId  String? // trusted only for signature-verified deliveries
  type           String?
  reason         String // missing_signature | not_configured | signature_invalid | no_tenant_scope | processing_error
  detail         String? // short error message (length-capped by the recorder)
  payloadSnippet String?  @db.Text // truncated raw body for diagnosis, never used for processing
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([reason, createdAt])
}

// Binary media storage (DB fallback when Cloudinary is not configured)
model Media {
  id             String   @id @default(cuid())
  organizationId String?
  filename       String
  mimeType       String
  size           Int
  data           String   @db.Text // base64
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole  @default(CLIENTE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Tenant membership (salon owners/admins/staff belong to an Organization)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accounts Account[]
  sessions Session[]
  reviews  Review[]

  // One-to-one relationships with business profiles
  staff    Staff? // If role=STAFF, MUST exist
  customer Customer? // If role=CLIENTE, MUST exist

  // Notification preferences
  notificationPreferences NotificationPreferences?

  // Inventory ledger entries created by this user (E2-2)
  stockMovements StockMovement[]

  // Projects created by this user (E2-3)
  projectsCreated Project[] @relation("ProjectCreatedBy")

  // Custom role (EPIC #4 G8) — when set, RESTRICTS this member to the
  // role's explicit permission set (org-scoped). Without it the legacy
  // ADMIN/STAFF behaviour is fully preserved.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role])
  @@index([customRoleId])
}

model NotificationPreferences {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailReminders     Boolean @default(true)
  reminderTime       String  @default("24h") // "24h" | "48h" | "1week"
  promotionalEmails  Boolean @default(false)
  appointmentUpdates Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  STAFF
  CLIENTE
}

// ============================================================
// CUSTOM ROLES (EPIC #4 G8) — org-scoped permission presets.
// "Admin brez financ", "senior frizer" … A CustomRole RESTRICTS
// the members assigned to it to an explicit permission set
// (catalog: src/lib/permissions/roles.ts). Users WITHOUT a
// custom role keep the legacy ADMIN/STAFF behaviour unchanged.
// ============================================================
model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // JSON array of PermissionKey strings — validated against the
  // catalog on every write (never trusted from the client raw).
  permissions Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([organizationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SalonConfig {
  id   String  @id @default(cuid())
  name String  @default("Beauty Salon")
  logo String?

  // Tenant owner (one config per Organization)
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Editable site content (hero, about, features, CTA, hours, social, SEO, sections)
  siteContent Json?
  // Theme overrides: { fontHeading?: string, fontBody?: string, radius?: string, colors?: {...} }
  theme       Json?

  // Published content snapshot (EPIC #3 E3-2): the siteContent JSON exactly as
  // it was at the last publish. The public site renders THIS (when present) so
  // draft edits stay private until "Objavi". Null = pre-E3-2 tenant: the public
  // site keeps rendering live siteContent (behavior unchanged).
  publishedSiteContent    Json?
  publishedContentVersion Int?

  // Branding colors
  primaryColor   String @default("#000000")
  secondaryColor String @default("#ffffff")
  accentColor    String @default("#d4af37")

  // Contact
  email   String?
  phone   String?
  address String?
  city    String?
  state   String?
  zipCode String?
  country String  @default("US")

  // Business hours
  timezone String @default("Europe/Ljubljana")
  currency String @default("EUR")
  locale   String @default("sl")

  // Booking settings
  bookingDeposit      Decimal     @default(50.00) @db.Decimal(10, 2)
  depositRefundable   Boolean     @default(false)
  // #79: the org-level deposit RULE (FIXED amount or PERCENT of service).
  bookingDepositType  DepositType @default(FIXED)
  // #78: org-level low-stock threshold. Product.reorderPoint overrides it
  // per product; resolved through src/lib/inventory/low-stock.ts (ONE helper
  // for the stats card, the table colour and the dashboard widget).
  defaultReorderPoint Int         @default(10)
  minBookingAdvance   Int         @default(24) // hours
  maxBookingAdvance   Int         @default(30) // days
  cancellationPolicy  String?     @db.Text

  // EPIC #4 E4-2b: optional per-tenant analytics integration (GA4).
  // Null/empty = NO analytics script is ever injected (honest default:
  // the platform does not track visitors on the owner's behalf until
  // the owner explicitly provides their own measurement ID).
  analyticsMeasurementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String

  // P2 #59: provenance of sample rows — preset id (e.g. "beekeeping") when
  // the row was seeded by seedOrganizationCatalog, NULL when owner-created.
  // "Dopolni katalog" replaces foreign-preset sample rows and never touches
  // owner-created (NULL) rows.
  presetSeed String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String // URL: /services/[slug] — unique PER ORGANIZATION (same-vertical tenants must not collide)
  description String? @db.Text
  // P2 #59: provenance of sample rows (preset id) — NULL = owner-created.
  presetSeed  String?
  duration    Int // minutes
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String? // Cloudinary Public ID (e.g. "services_haircut_ksqpaa")
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false) // Display on landing page
  order       Int     @default(0) // Order of featured services (lower = first)

  // #79: deposit as a RULE, not one global number. INHERIT follows the
  // org setting; NONE exempts the service; FIXED is currency; PERCENT is
  // 0–100 of the service price. Resolution lives in ONE pure helper
  // (src/lib/booking/deposit.ts) so booking, Stripe and the record can
  // never disagree.
  depositType  DepositType @default(INHERIT)
  depositValue Decimal?    @db.Decimal(10, 2) // currency (FIXED) or 0–100 (PERCENT)

  categoryId String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointmentServices AppointmentService[]
  staffServices       StaffService[]
  reviews             Review[]
  gallery             ServiceGallery[]
  faqs                ServiceFAQ[]
  packageItems        PackageItem[]
  // #90: čakanja na prosto mesto za to storitev
  waitlistEntries     WaitlistEntry[]
  // #92: izbirni dodatki storitve (npr. +ulje za gume) — cena in
  // trajanje se prištejeta rezervaciji (strežniški izračun).
  addons              ServiceAddon[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

// Service Reviews/Testimonials
model Review {
  id             String   @id @default(cuid())
  rating         Int // 1-5 stars
  comment        String   @db.Text
  // P2 #75: nullable — null = ocena PODJETJA (najemnika), ne posamezne
  // storitve. Profili z services: "disabled" (čebelarstvo) prej NISO
  // mogli ničesar oceniti: forma je živela samo na /services/[slug].
  serviceId      String?
  // P2 #75: najemnik direktno (prej izveden skozi service → ni mogel
  // obstajati ocena brez storitve). Backfill iz service.organizationId.
  organizationId String
  userId         String
  isActive       Boolean  @default(true) // For moderation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([userId])
  @@index([isActive])
  @@index([organizationId])
}

// Service Gallery (before/after photos)
model ServiceGallery {
  id        String   @id @default(cuid())
  imageUrl  String // Cloudinary Public ID
  caption   String?
  order     Int      @default(0)
  serviceId String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// Service FAQs
model ServiceFAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  serviceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Staff {
  id       String  @id @default(cuid())
  name     String
  email    String?
  phone    String?
  bio      String? @db.Text
  image    String?
  isActive Boolean @default(true)

  // #79: payroll layer — default tip rate (checkout suggestion) and the
  // commission rule. commissionAmount is computed ONCE when an appointment
  // completes and stored on the appointment, so a later rate change never
  // rewrites history.
  defaultTipPercent Decimal?       @db.Decimal(5, 2) // 0–100, checkout suggestion
  commissionType    CommissionType @default(NONE)
  commissionValue   Decimal?       @db.Decimal(10, 2) // percent (PERCENT) or currency (FIXED)
  commissionBasis   String         @default("service") // "service" | "service+product"

  // REQUIRED one-to-one relationship with User (all staff can login)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     StaffService[]
  appointments Appointment[]
  workingHours WorkingHours[]

  @@index([userId])
  @@index([organizationId])
  @@index([isActive])
  @@index([email])
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model WorkingHours {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  startTime String // "09:00"
  endTime   String // "17:00"
  isActive  Boolean @default(true)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model Customer {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  notes String? @db.Text

  // #91: proste oznake lastnika (»VIP«, »rdeča«, …) — segment = oznaka.
  // Vstopna točka za ciljane kampanje (P1 marketing sklop). Urejene
  // samo prek updateCustomerTags (whitelist sanitizacija, org-scoped).
  tags String[] @default([])

  // OPTIONAL one-to-one relationship with User
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments     Appointment[]
  orders           Order[]
  // #80: sold prepaid products (gift cards / packages) owned by the customer.
  prepaidPurchases PrepaidPurchase[]
  formSubmissions  FormSubmission[]
  workOrders       WorkOrder[]
  documents        Document[]
  extensionRecords ExtensionRecord[]
  projects         Project[]

  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

// ============================================================
// #90 — ČAKALNA LISTA (honest waitlist v1)
// Gost prijavi zahtevo za zaseden termin; ob odprtju prostora
// lastnik z enim klikom obvesti čakajoče (email s povezavo v
// rezervacijo). Brez auto-book: obvestilo, ne tiha rezervacija.
// Org-scoped povsod — vnos najemnika A nikoli viden najemniku B.
// ============================================================
enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Gost še ni stranka — kontaktni podatki vstopa (email obvezen,
  // ker obveščanje teče po e-pošti v v1).
  name  String
  email String
  phone String?

  // Željena storitev (neobvezna — »karkoli prosto«) in približen datum.
  serviceId     String?
  service       Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  preferredDate DateTime?
  notes         String?    @db.Text

  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([serviceId])
}

// ============================================================
// #92 — DODATKI STORITVE (add-ons, Square pattern)
// Izbirni doplačila k storitvi: cena + trajanje se prištejeta
// rezervaciji ATOMARNO (strežniški izračun, nikoli zaupanje
// klientu). Snapshot izbranih dodatkov se zapiše na termin, torej
// kasnejša sprememba cene ne prepiše zgodovine.
// ============================================================
model ServiceAddon {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal @db.Decimal(10, 2)
  durationMin Int     @default(0)
  position    Int     @default(0)
  isActive    Boolean @default(true)

  @@index([serviceId, isActive])
}

model Appointment {
  id         String  @id @default(cuid())
  staffId    String
  customerId String?

  // Walk-in customer without registered Customer
  guestName  String?
  guestEmail String?
  guestPhone String?

  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?           @db.Text

  // Optional physical resource (E2-7, G7): a `workspace` ExtensionRecord
  // (extensionId "workspace-resources") acting as the room/chair/station
  // for this appointment. Only offered when the org profile enables the
  // `workspace-resources` extension AND `appointments`. Conflict-checked
  // server-side: one booking per resource at a time. SetNull on delete —
  // removing a resource never deletes appointments.
  resourceRecordId String?

  // Payment ($50 non-refundable deposit)
  totalPrice      Decimal @db.Decimal(10, 2)
  depositAmount   Decimal @default(50.00) @db.Decimal(10, 2)
  depositPaid     Boolean @default(false)
  // #93: unikaten — webhook in /booking/success verify pot ustvarjata
  // termin iz istega plačila; brez constrainta je check-then-act dirka
  // lahko ustvari DVA CONFIRMED termina iz enega paymentIntentId.
  // Postgres unique index dopušča poljubno mnogo NULL (termini brez
  // Stripe plačila ostanejo veljavni).
  stripePaymentId String? @unique

  // #79: tips are revenue the salon collects but must NOT count as service
  // revenue; commission is frozen at completion (null = not yet computed).
  tipAmount        Decimal  @default(0) @db.Decimal(10, 2)
  tipMethod        String? // "cash" | "card"
  commissionAmount Decimal? @db.Decimal(10, 2) // written once on COMPLETED

  // #92: snapshot izbranih dodatkov ob rezervaciji — seznam z name,
  // price in durationMin. Cene/dodatki kasneje spremeni katalog,
  // zgodovina termina ostane točna (isti princip kot commissionAmount).
  // NB: brez oklepajev v komentarju — schema-tenancy test seka bloke
  // po prvem zaklepaju.
  addons Json?

  // Notifications
  reminderSentAt     DateTime?
  confirmationSentAt DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff              Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resource           ExtensionRecord?     @relation("AppointmentResource", fields: [resourceRecordId], references: [id], onDelete: SetNull)
  // #80: package sessions redeemed with this appointment.
  prepaidRedemptions PrepaidRedemption[]
  services           AppointmentService[]

  @@index([staffId])
  @@index([customerId])
  @@index([organizationId])
  @@index([startTime])
  @@index([status])
  @@index([depositPaid])
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// #79: deposit as a rule — service level (INHERIT resolves the org one)
// and the org-level default live in this one vocabulary.
enum DepositType {
  INHERIT
  NONE
  FIXED
  PERCENT
}

// #79: commission rules per staff member.
enum CommissionType {
  NONE
  PERCENT
  FIXED
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  // #77: NO platform-wide @unique on sku — a SKU is unique per tenant
  // (see @@unique([organizationId, sku]) below), not across the platform.
  sku            String?

  // Inventory
  trackInventory Boolean @default(true)
  stockQuantity  Int     @default(0)

  // #78: retail layer — the fields a real shop needs on top of stock.
  // `price` stays GROSS (DDV included, Slovenian convention); `vatRate`
  // states which rate is inside the gross price (null = standard 22 %).
  // `forSale` is NOT a rename of `trackInventory`: trackInventory says
  // "do we count it", forSale says "do we sell it" (back-bar shampoo is
  // tracked but not sellable; a gift box sellable but maybe not tracked).
  barcode      String?
  brand        String?
  unit         String   @default("kos")
  vatRate      Decimal? @db.Decimal(5, 2) // 0–100, e.g. 9.50 or 22.00
  forSale      Boolean  @default(true)
  reorderPoint Int? // per-product low-stock threshold (null = org default)

  // P2 #59: provenance of sample rows (preset id) — NULL = owner-created.
  presetSeed String?

  // Images
  images String[]

  // Category
  categoryId String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  variants       ProductVariant[]
  packageItems   PackageItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  // #78: barcode is unique per tenant (same rule as SKU, #77).
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([organizationId, forSale])
}

model Order {
  id         String  @id @default(cuid())
  customerId String?

  // Guest checkout without registered Customer
  guestName  String?
  guestEmail String?
  guestPhone String?

  // Totals (in-store pickup only, no shipping)
  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // #79: tip on a product order (cash or card), separate from item prices.
  tipAmount Decimal @default(0) @db.Decimal(10, 2)
  tipMethod String? // "cash" | "card"

  status OrderStatus @default(PENDING)

  // P1 #65: how the order is meant to be paid — "online" (Stripe hosted
  // checkout) or "offline" (created without Stripe: owner collects payment
  // on pickup/delivery). Orders default to "online" (all pre-#65 rows).
  paymentMethod String @default("online")

  // Payment
  stripePaymentIntentId String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  stockMovements     StockMovement[]
  // #80: gift-card redemption applied to this order (null = none).
  prepaidRedemptions PrepaidRedemption[]

  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED // Entregado en tienda
  CANCELLED
  REFUNDED
}

// ============================================================
// ACTIVITY PROFILE ENGINE (EPIC #1) — per-tenant materialized
// definitions. Profile templates (src/lib/profiles/registry.ts)
// are copied on-write at onboarding so the owner can customize
// forms/workflows without code and without mutating the shared
// profile. All rows are strictly org-scoped.
// ============================================================

/// Reusable dynamic form template (fields + validation) owned by a tenant.
model FormDefinition {
  id             String  @id @default(cuid())
  organizationId String
  key            String // stable template key, e.g. "order-details", "vehicle-intake"
  name           String
  description    String?
  version        Int     @default(1)
  isActive       Boolean @default(true)
  fields         Json // ProfileFieldDef[] — validated server-side on read/write
  // P1 #69: provenance — profile id when materialized from the registry,
  // NULL when owner-created (never deactivated by an activity switch).
  sourceProfile  String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// A filled-in form. Context is polymorphic (contextType + contextId) because
/// the universal core must not assume which entity the form belongs to
/// (appointment, work order, vehicle, batch, …). customer is a real FK since
/// customers are a universal primitive.
model FormSubmission {
  id               String  @id @default(cuid())
  organizationId   String
  formDefinitionId String
  data             Json
  status           String  @default("NEW") // NEW | IN_REVIEW | PROCESSED
  customerId       String?
  contextType      String? // "appointment" | "order" | custom entity key
  contextId        String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formDefinition FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([formDefinitionId])
  @@index([customerId])
  @@index([contextType, contextId])
}

/// Configurable business process (e.g. seamstress production pipeline)
/// owned by a tenant; stages define the allowed progression.
model WorkflowDefinition {
  id             String  @id @default(cuid())
  organizationId String
  key            String // stable key, e.g. "production-order"
  name           String
  entity         String // "order" | "appointment" | custom entity key
  version        Int     @default(1)
  isActive       Boolean @default(true)
  // P1 #69: provenance — profile id when materialized, NULL = owner-created.
  sourceProfile  String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       WorkflowStage[]
  workOrders   WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model WorkflowStage {
  id           String  @id @default(cuid())
  definitionId String
  key          String
  name         String
  description  String?
  order        Int
  slaHours     Int?
  isFinal      Boolean @default(false)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, key])
  @@index([definitionId])
}

// ============================================================
// WORK ORDERS (EPIC #1 Phase 4, §9 universal workflow engine)
// A work order is a job tracked through a tenant's configurable
// WorkflowDefinition stages (e.g. seamstress production pipeline,
// vehicle workshop work order). Deliberately SEPARATE from the
// shop Order model so appointment-less industries get a first-
// class operational entity without touching e-commerce flows.
// All rows are strictly org-scoped. Stage transitions are
// validated server-side; every change is appended to WorkOrderEvent
// (full audit trail, §17).
// ============================================================

model WorkOrder {
  id             String @id @default(cuid())
  organizationId String
  number         Int // human-friendly, sequential per tenant
  title          String
  status         String @default("OPEN") // OPEN | COMPLETED | CANCELLED
  priority       String @default("NORMAL") // LOW | NORMAL | HIGH | URGENT

  // Workflow state (validated transitions, history in events)
  workflowDefinitionId String?
  currentStageKey      String?

  // Planning
  dueDate DateTime?
  total   Decimal?  @db.Decimal(10, 2)
  notes   String?   @db.Text

  // Origin: the public form submission that produced this order (if any)
  sourceSubmissionId String? @unique

  // Optional link to an extension registry record (e.g. the vehicle
  // being serviced in a workshop) — universal, extension-agnostic.
  linkedRecordId String? @unique

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  workflowDefinition WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)
  linkedRecord       ExtensionRecord?    @relation(fields: [linkedRecordId], references: [id], onDelete: SetNull)
  events             WorkOrderEvent[]
  documents          Document[]
  projects           Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([dueDate])
}

/// Append-only audit trail for a work order: creation, stage
/// transitions (validated), notes and status changes (§9, §17).
model WorkOrderEvent {
  id             String  @id @default(cuid())
  organizationId String
  workOrderId    String
  type           String // CREATED | STAGE_CHANGED | NOTE | STATUS_CHANGED
  fromStageKey   String?
  toStageKey     String?
  message        String? @db.Text
  actorEmail     String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([workOrderId, createdAt])
}

// ============================================================
// EXTENSION RECORDS (EPIC #1 §13 — Phase 6, universal extension
// runtime). One org-scoped, generic store for the entities that
// ENABLED EXTENSIONS declare (vehicle registry for workshops,
// tire sets, harvest batches for beekeeping, measurement sets,
// workspaces …). The record shape is NOT hardcoded per industry:
//   • (extensionId, entityKey) select the declaration in the
//     extension registry (src/lib/profiles/extensions.ts);
//   • `data` holds values validated server-side against the
//     declarative field list — the client can never inject
//     unknown fields (same pattern as FormSubmission);
//   • customer is a real FK (customers are a universal primitive),
//     work orders link back polymorphically via WorkOrder.linkedRecordId.
// Adding a new extension = registry entry only, no migration.
// ============================================================

model ExtensionRecord {
  id             String @id @default(cuid())
  organizationId String
  extensionId    String // extension registry id, e.g. "vehicle-workshop"
  entityKey      String // entity key inside the extension, e.g. "vehicle"
  title          String // human label derived from the first meaningful field
  data           Json // validated values per the declared fields

  customerId String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  linkedWorkOrders WorkOrder[]

  // E2-2 inventory runtime — soft links FROM the stock ledger
  stockMovementsAsSupplier StockMovement[] @relation("StockMovementSupplier")
  stockMovementsAsBatch    StockMovement[] @relation("StockMovementBatch")

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  // E2-7 (G7): appointments booked into this workspace resource.
  resourceAppointments Appointment[] @relation("AppointmentResource")

  @@index([organizationId])
  @@index([organizationId, entityKey])
  @@index([customerId])
}

// ============================================================
// CATALOG PACKAGES & VARIANTS (EPIC #1 Phase 4b, §11 universal
// catalog). Variants: size/color/material variants of a product
// with optional price/stock override. Packages: sellable bundles
// combining services AND products at a package price — useful
// for salons (treatment packages) as well as production
// businesses (kits). All rows are strictly org-scoped.
// ============================================================

/// Variant of a product (e.g. "Velikost L / Temno modra").
/// price null → the product's base price applies.
model ProductVariant {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  name           String
  sku            String?
  price          Decimal? @db.Decimal(10, 2)
  trackInventory Boolean  @default(true)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  position       Int      @default(0)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([productId])
}

/// Sellable PREPAID VALUE (#80) — one primitive for gift cards,
/// session packages and (later) memberships. The DB table stays
/// "Package" (@@map) so every existing id/row survives the evolution
/// from "bundle definition" to "sellable prepaid product".
/// kind GIFT_CARD = money up front (faceValue, balance);
/// kind PACKAGE = prepaid sessions (sessionCount, session tracking);
/// kind MEMBERSHIP = reserved for the scheduler issue — NOT in this PR.
enum PrepaidKind {
  GIFT_CARD
  PACKAGE
  MEMBERSHIP
}

model PrepaidProduct {
  id             String      @id @default(cuid())
  organizationId String
  kind           PrepaidKind @default(PACKAGE)
  name           String
  description    String?     @db.Text
  price          Decimal     @db.Decimal(10, 2) // what the customer pays
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  // GIFT_CARD: redeemable amount (>= price allowed); null = same as price.
  faceValue      Decimal?    @db.Decimal(10, 2)
  // PACKAGE: number of visits the buyer is entitled to.
  sessionCount   Int?
  // Days from purchase until the purchase expires; null = never expires.
  validityDays   Int?
  // Which services a PACKAGE/MEMBERSHIP covers (gift cards ignore it).
  serviceIds     String[]
  isActive       Boolean     @default(true)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PackageItem[]
  purchases    PrepaidPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, kind])
  @@index([isActive])
  // #80: the table name STAYS "Package" — every existing row/id survives
  // the evolution from "bundle definition" to "sellable prepaid product",
  // with zero data migration (new columns only, all backfilled by defaults).
  @@map("Package")
}

/// One SOLD instance of a prepaid product — the liability the owner owes.
/// GIFT_CARD: balance = money left; PACKAGE: sessionsLeft = visits left.
/// status PENDING = awaiting online payment; ACTIVE = redeemable.
model PrepaidPurchase {
  id               String    @id @default(cuid())
  organizationId   String
  prepaidProductId String
  customerId       String?
  guestEmail       String?
  // GIFT_CARD redeemable code — globally unique (a code from salon A is
  // unambiguous, never matches salon B's balance lookup).
  code             String    @unique
  purchasedAt      DateTime  @default(now())
  expiresAt        DateTime?
  balance          Decimal   @default(0) @db.Decimal(10, 2) // GIFT_CARD money left
  sessionsLeft     Int? // PACKAGE visits left
  status           String    @default("PENDING") // PENDING | ACTIVE | EXHAUSTED | EXPIRED | REFUNDED
  // How it was paid: Stripe session id (online sale, idempotent activation)
  stripeSessionId  String?
  note             String?   @db.Text

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prepaidProduct PrepaidProduct      @relation(fields: [prepaidProductId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  redemptions    PrepaidRedemption[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([prepaidProductId])
  @@index([customerId])
}

/// One redemption event: money off an order or one visit of a package.
/// @@unique([prepaidPurchaseId, orderId]) and ([prepaidPurchaseId,
/// appointmentId]) make double-redemption of the SAME order/appointment
/// impossible at the database level.
model PrepaidRedemption {
  id                String   @id @default(cuid())
  prepaidPurchaseId String
  appointmentId     String?
  orderId           String?
  amount            Decimal? @db.Decimal(10, 2) // GIFT_CARD money used
  sessions          Int      @default(0) // PACKAGE visits consumed
  createdAt         DateTime @default(now())

  prepaidPurchase PrepaidPurchase @relation(fields: [prepaidPurchaseId], references: [id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([prepaidPurchaseId, orderId])
  @@unique([prepaidPurchaseId, appointmentId])
  @@index([prepaidPurchaseId])
  @@index([orderId])
  @@index([appointmentId])
}

/// One line of a package: either a service or a product with quantity.
model PackageItem {
  id        String  @id @default(cuid())
  packageId String
  itemType  String // "service" | "product"
  serviceId String?
  productId String?
  quantity  Int     @default(1)
  position  Int     @default(0)

  // #80: the package's product side — table name kept via @@map on PrepaidProduct.
  package PrepaidProduct @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([serviceId])
  @@index([productId])
}

// ============================================================
// DOCUMENTS (EPIC #1 Phase 4b, §13 documents capability).
// Quotes (predračuni) and invoices (računi) with per-tenant
// sequential numbering and printable line-item layout. Deliberately
// generic (not Stripe-bound) so every profile can issue them;
// optional links: customer (universal primitive) and work order.
// All rows are strictly org-scoped.
// ============================================================

/// QUOTE statuses: DRAFT | SENT | ACCEPTED | REJECTED
/// INVOICE statuses: DRAFT | ISSUED | PAID | CANCELLED
model Document {
  id             String @id @default(cuid())
  organizationId String
  type           String // QUOTE | INVOICE
  number         Int // human-friendly, sequential per tenant AND type
  status         String @default("DRAFT")

  customerId  String?
  workOrderId String?

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  total     Decimal   @db.Decimal(10, 2)
  notes     String?   @db.Text

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workOrder    WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  items        DocumentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type, number])
  @@index([organizationId])
  @@index([organizationId, type, status])
  @@index([customerId])
  @@index([workOrderId])
}

/// Printable line of a document (free description — catalog
/// binding stays loose so documents never break when catalog
/// items are renamed or deleted).
model DocumentItem {
  id             String  @id @default(cuid())
  organizationId String
  documentId     String
  description    String
  quantity       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  position       Int     @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organizationId])
}

// ============================================================
// CUSTOM DOMAIN (EPIC #3 E3-6) — a tenant-owned hostname pointed
// at the platform. Status is driven EXCLUSIVELY by provider
// confirmation (Vercel Domains API): the app NEVER marks a domain
// connected/secure on its own — issue #3 §7. Without a configured
// DOMAINS_VERCEL_* token the flow honestly reports "setup required"
// and the record simply stays PENDING.
// ============================================================
model CustomDomain {
  id             String @id @default(cuid())
  organizationId String
  domain         String @unique // normalized (lowercase, host only)

  // PENDING | VERIFIED | FAILED — VERIFIED requires provider confirmation
  status String @default("PENDING")

  // Exactly one primary domain per tenant (only VERIFIED can be primary)
  isPrimary Boolean @default(false)

  // DNS guidance captured from the provider (JSON array of
  // records: type, name, value, description?) — rendered in Settings.
  dnsRecords    Json?
  lastError     String?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

// ============================================================
// STOCK MOVEMENT LEDGER (EPIC #2 E2-2) — append-only inventory
// runtime. Each row is ONE stock event (receipt / issue); the
// product/variant `stockQuantity` is the STATE, this table is
// the LEDGER. Manual in/out flows update state + ledger in one
// transaction; negative stock is rejected server-side.
// Traceability: optional soft links to ExtensionRecord rows
// (supplier / batch) keep §9.6 provenance without duplicating
// the extension registry.
// ============================================================

enum StockDirection {
  IN
  OUT
}

enum StockMovementSource {
  MANUAL
  ORDER
  // #78: a delivery can be RECEIVED as one event (N rows share a note),
  // a stock take writes only the DELTA, a customer return comes back IN.
  DELIVERY
  STOCKTAKE
  RETURN
}

model StockMovement {
  id               String              @id @default(cuid())
  organizationId   String
  productId        String
  productVariantId String?
  direction        StockDirection
  quantity         Int // always > 0 (validated in actions)
  source           StockMovementSource @default(MANUAL)
  note             String?             @db.Text

  // When source = ORDER: the shop order that caused the issue
  orderId String?

  // Traceability links (E2-2): supplier + batch via ExtensionRecord
  supplierRecordId String?
  batchRecordId    String?

  createdById String?

  createdAt DateTime @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplierRecord ExtensionRecord? @relation("StockMovementSupplier", fields: [supplierRecordId], references: [id], onDelete: SetNull)
  batchRecord    ExtensionRecord? @relation("StockMovementBatch", fields: [batchRecordId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// PROJECTS & TASKS (EPIC #2 E2-3) — runtime for the `projects`
// extension: multi-day jobs that are NOT one-off appointments
// (photographer shoots, cleaning contracts, custom tailoring…).
// Real models per the E2-2 precedent — runtime behavior (task
// progress gating project completion, deadline warnings, work-
// order links) needs real relations and aggregate queries;
// static registry-only data stays in ExtensionRecord.
// Strictly org-scoped; the client can never inject foreign ids
// (same validation as every EPIC #1 action).
// ============================================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  status         ProjectStatus @default(PLANNING)

  // Planning window — deadline drives overdue/due-soon warnings
  startDate DateTime?
  deadline  DateTime?
  budget    Decimal?  @db.Decimal(10, 2)
  notes     String?   @db.Text

  // Optional links, validated same-org in actions:
  //   customer   — the client the project is for;
  //   workOrder  — „povezava na delovno naročilo“ (quotes/invoices
  //                remain reachable through the work order).
  customerId  String?
  workOrderId String?

  createdById String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        ProjectTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([workOrderId])
  @@index([deadline])
}

model ProjectTask {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  status         ProjectTaskStatus @default(OPEN)
  dueDate        DateTime?
  assigneeName   String?
  hoursEst       Float?
  notes          String?           @db.Text
  position       Int               @default(0) // stable manual order within the project

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([projectId, position])
}

// ============================================================
// CONFIG CHANGE LOG (EPIC #2 E2-5, G5) — append-only history of
// tenant configuration edits: profile overrides, form definitions
// and workflow definitions. Every change appends ONE row with the
// previous/next JSON snapshot and a per-org+entity monotonic
// version. A revert NEVER rewrites or deletes history — it
// applies an old snapshot and appends a NEW version entry
// (audit trail stays intact, §5/§6/§11).
// entityKey: "profileOverrides" | "form:{formKey}" | "workflow:{workflowKey}"
// ============================================================
model ConfigChangeLog {
  id             String   @id @default(cuid())
  organizationId String
  entityKey      String
  version        Int // monotonic per (organizationId, entityKey), starts at 1
  actorEmail     String // authenticated owner/admin who made the change
  action         String // UPDATE | RESET | REVERT
  summary        String? // short human-readable description (owner's locale)
  previous       Json? // snapshot BEFORE the change (null on first entry)
  next           Json? // snapshot AFTER the change (this is what revert restores)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityKey, version])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityKey])
}

// ============================================================
// JOB RUN LOG (P1 #76) — append-only diary of scheduled jobs
// (cron tick). "Did the reminder go out?" must be answerable
// without reading Vercel logs: every run writes one row with
// counters. A silently failing cron is worse than no cron.
// ============================================================
model JobRun {
  id         String    @id @default(cuid())
  job        String // "send-due-reminders" | "expire-stale-pending" | …
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(true)
  sent       Int       @default(0)
  failed     Int       @default(0)
  detail     Json?

  @@index([job, startedAt])
}
